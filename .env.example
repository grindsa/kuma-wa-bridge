# --- local image tag (built on the Pi) ---
IMAGE=kuma-wa-bridge:latest

# --- publish on host ---
BIND_HOST=127.0.0.1
HOST_PORT=8089
NETWORK_NAME=pi-monitor

# --- wa_hack daemon (same idea as tipp_game) ---
WA_SRV=192.168.1.50
WA_PORT=9009

# WhatsApp destination (international digits, no +)
WA_RECIPIENT=4917012345678
# WA_ADMIN_NUMBER=4917012345678

# Shared secret for Kuma → bridge (Authorization: Bearer …)
WEBHOOK_TOKEN=change-me-to-a-long-random-string

LOG_LEVEL=INFO

# --- weekly backup (scripts/backup.sh) ---
# BACKUP_ROOT=/var/tmp/kuma-backups
# TMP_ROOT=/var/tmp
# LOCAL_KEEP=4
# REMOTE_KEEP=12
# REMOTE_TARGET=user@backup-host
# REMOTE_DIR=/public/Backups/pi-dns/kuma
# SSH_KEY=/home/joern/.ssh/id_ed25519
# STACK_KUMA_WA_BRIDGE=/srv/stacks/kuma-wa-bridge
# STACK_KUMA=/srv/stacks/kuma
# DATA_KUMA=/srv/data/kuma
# WA notify uses WEBHOOK_TOKEN above; optional override:
# WA_BRIDGE_URL=http://127.0.0.1:8089/webhook

