# --- local image tag (built on the Pi) ---
IMAGE=kuma-wa-bridge:latest

# --- publish on host ---
BIND_HOST=127.0.0.1
HOST_PORT=8089
NETWORK_NAME=pi-monitor

# --- wa_hack daemon (same idea as tipp_game) ---
WA_SRV=192.168.1.50
WA_PORT=9009

# WhatsApp destination (international digits, no +)
WA_RECIPIENT=4917012345678
# WA_ADMIN_NUMBER=4917012345678

# Shared secret for Kuma → bridge (Authorization: Bearer …)
WEBHOOK_TOKEN=change-me-to-a-long-random-string

LOG_LEVEL=INFO
